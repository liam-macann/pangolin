#!/usr/bin/env bash
set -e

UPSTREAM="$(git rev-parse @{u} 2>/dev/null || echo origin/main)"
CHANGED=$(git diff --name-only "$UPSTREAM"...HEAD)

pnpm biome check --changed --since="$UPSTREAM"

if [ -n "$CHANGED" ]; then
  echo "$CHANGED" | xargs pnpm vitest related --run
else
  echo "No changed files, skipping tests."
fi
