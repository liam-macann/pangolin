{
	"$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 100,
		"attributePosition": "auto",
		"bracketSameLine": false,
		"bracketSpacing": true,
		"expand": "auto",
		"useEditorconfig": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"requireAscii": true,
						"filenameCases": ["kebab-case"]
					}
				},
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"better-auth": {
								"importNames": ["Session"],
								"message": "Prefer using Session from @/auth"
							}
						},
						"patterns": [
							{
								"group": ["../**"],
								"message": "Do not use relative parent imports. Use defined TS aliases (e.g., @/components/*) instead."
							},

							{
								"group": ["@/components/ui/**"],
								"message": "Prefer using @/ui alias directly."
							},

							{
								"group": ["@/src/test/**"],
								"message": "Prefer using @/test alias directly."
							},

							{
								"group": ["@uidotdev/usehooks"],
								"message": "Prefer importing from @/lib/hooks"
							},

							{
								"group": ["usehooks-ts"],
								"message": "Prefer importing from @/lib/hooks"
							},

							{
								"group": ["@/ui/dialog"],
								"message": "You may want to use @/ui/responsive-dialog"
							}
						]
					}
				},
				"useImportType": {
					"level": "on",
					"options": { "style": "inlineType" }
				}
			},
			"nursery": {
				"noDrizzleDeleteWithoutWhere": {
					"level": "error",
					"options": { "drizzleObjectName": ["db", "tx"] }
				},
				"noDrizzleUpdateWithoutWhere": {
					"level": "error",
					"options": { "drizzleObjectName": ["db", "tx"] }
				},
				"useSortedClasses": {
					"level": "error",
					"fix": "safe",
					"options": {
						"attributes": ["className", "class"],
						"functions": ["cn", "cva", "clsx", "twMerge"]
					}
				}
			}
		},
		"domains": {
			"next": "recommended",
			"react": "recommended",
			"project": "recommended",
			"drizzle": "recommended",
			"test": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"jsxQuoteStyle": "single",
			"quoteProperties": "asNeeded",
			"trailingCommas": "all",
			"semicolons": "always",
			"arrowParentheses": "asNeeded",
			"bracketSameLine": false,
			"quoteStyle": "single",
			"attributePosition": "auto",
			"bracketSpacing": true,
			"indentStyle": "tab"
		}
	},
	"html": {
		"formatter": {
			"selfCloseVoidElements": "always"
		}
	},
	"css": {
		"formatter": {
			"enabled": true
		},
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							":BLANK_LINE:",
							":URL:",
							":NODE:",
							":PACKAGE_WITH_PROTOCOL:",
							":PACKAGE:",
							":BLANK_LINE:",
							"@/api",
							"@/api/**",
							"@/lib/**",
							"@/db",
							"@/db/**",
							":BLANK_LINE:",
							["@/components/**", "@/ui/**"],
							":BLANK_LINE:",
							":ALIAS:",
							":BLANK_LINE:"
						]
					}
				}
			}
		}
	}
}
