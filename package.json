	"devEngines": {
		"packageManager": {
			"name": "nub",
			"version": "^0.7.5",
			"onFail": "ignore"
		}
	},
	"allowBuilds": {
		"bcrypt": true,
		"sharp": true,
		"@scarf/scarf": false,
		"@sentry/cli": true,
		"core-js": true,
		"esbuild": true,
		"msw": false,
		"vue-demi": true,
		"@nubjs/nub": true
	}
