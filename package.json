{
	"private": true,
	"scripts": {
		"prebuild": "tsx ./scripts/generateStaticFiles.ts",
		"build": "next build",
		"predev": "tsx ./scripts/generateStaticFiles.ts",
		"dev": "NODE_OPTIONS=\"--dns-result-order=ipv6first\" next dev --turbopack",
		"start": "next start",
		"lint": "biome lint",
		"format": "biome format --write",
		"check": "biome check --write",
		"prepare": "husky",
		"db:seed": "NODE_OPTIONS=\"--dns-result-order=ipv6first\" node --import tsx --env-file=.env.local ./scripts/seed.ts",
		"db:view": "NODE_OPTIONS=\"--dns-result-order=ipv6first\" pnpm exec drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"lint-staged": {
		"*": ["biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"]
	},
