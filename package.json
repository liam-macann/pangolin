{
	"private": true,
	"imports": {
		"#rpc": {
			"react-server": "./src/app/api/rpc/index.server.ts",
			"default": "./src/app/api/rpc/index.client.ts"
		}
	},
	"engines": {
		"node": "24.x"
	},
	"type": "module",
	"browserslist": ["defaults and fully supports es6-module", "maintained node versions"],
	"scripts": {
		"build": "next build",
		"dev": "NODE_OPTIONS=\"--dns-result-order=ipv6first\" next dev --turbopack",
		"start": "next start",
		"lint": "biome lint",
		"format": "biome format --write",
		"check": "biome check --write",
		"typecheck": "next typegen && tsc --noEmit",
		"prepare": "husky",
		"db:seed": "NODE_OPTIONS=\"--dns-result-order=ipv6first\" nub --env-file=.env.local ./scripts/seed.ts",
		"db:view": "NODE_OPTIONS=\"--dns-result-order=ipv6first\" nubx drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit check && drizzle-kit migrate",
		"db:sync-currencies": "nub ./scripts/sync-currencies.ts",
		"openapi:generate": "nub ./scripts/generate-openapi.ts",
		"openapi:lint": "nub run openapi:generate && spectral lint openapi.json --fail-severity=warn",
		"test": "vitest --typecheck",
		"test:run": "vitest run --typecheck",
		"test:browser": "vitest --project browser",
		"coverage": "vitest run --coverage"
	},
	"lint-staged": {
		"*": ["biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"]
	},
