{
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"browserslist": ["defaults and fully supports es6-module", "maintained node versions"],
	"scripts": {
		"build": "next build",
		"dev": "NODE_OPTIONS=\"--dns-result-order=ipv6first\" next dev --turbopack",
		"start": "next start",
		"lint": "biome lint",
		"format": "biome format --write",
		"check": "biome check --write",
		"prepare": "husky",
		"db:seed": "NODE_OPTIONS=\"--dns-result-order=ipv6first\" node --import tsx --env-file=.env.local ./scripts/seed.ts",
		"db:view": "NODE_OPTIONS=\"--dns-result-order=ipv6first\" pnpm exec drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit check && drizzle-kit migrate",
		"db:sync-currencies": "tsx ./scripts/sync-currencies.ts",
		"test": "vitest --typecheck",
		"test:run": "vitest run --typecheck",
		"test:browser": "vitest --project browser",
		"coverage": "vitest run --coverage"
	},
	"lint-staged": {
		"*": ["biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"]
	},
