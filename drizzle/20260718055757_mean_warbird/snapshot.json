				"definition": "select \"invoice_item\".\"id\", \"invoice_item\".\"invoice_id\", \"invoice_item\".\"label\", \"invoice_item\".\"note\", \"invoice_item\".\"quantity\", \"invoice_item\".\"unit\", \"invoice_item\".\"unit_cost\", \"invoice_item\".\"net_amount\", \"invoice_item\".\"order\", \"invoice_item\".\"user_id\", \"invoice_item\".\"config_id\", \"config\".\"tax_registration\", ((1 + COALESCE(sum(\"tax\".\"rate\") * \"config\".\"tax_registration\"::INT, 0)) * \"invoice_item\".\"net_amount\")::NUMERIC(19, 4) as \"gross_amount\" from \"invoice_item\" left join \"item_tax\" on \"item_tax\".\"item_id\" = \"invoice_item\".\"id\" left join \"tax\" on \"item_tax\".\"tax_id\" = \"tax\".\"id\" left join \"invoice\" on \"invoice_item\".\"invoice_id\" = \"invoice\".\"id\" left join \"config\" on \"invoice\".\"config_id\" = \"config\".\"id\" group by \"invoice_item\".\"id\", \"config\".\"id\""
