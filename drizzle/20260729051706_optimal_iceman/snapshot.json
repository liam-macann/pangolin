			"key": "views\u0000[\"public\",\"items_with_tax\"]",
			"set": {
				"definition": "select \"line_item\".\"id\", \"line_item\".\"invoice_id\", \"line_item\".\"label\", \"line_item\".\"note\", \"line_item\".\"quantity\", \"line_item\".\"unit\", \"line_item\".\"unit_cost\", \"line_item\".\"net_amount\", \"line_item\".\"order\", \"line_item\".\"user_id\", \"line_item\".\"config_id\", \"config\".\"tax_registration\", ((1 + COALESCE(sum(\"tax\".\"rate\") * \"config\".\"tax_registration\"::INT, 0)) * \"line_item\".\"net_amount\")::NUMERIC(19, 4) as \"gross_amount\" from \"line_item\" left join \"item_tax\" on \"item_tax\".\"item_id\" = \"line_item\".\"id\" left join \"tax\" on \"item_tax\".\"tax_id\" = \"tax\".\"id\" left join \"invoice\" on \"line_item\".\"invoice_id\" = \"invoice\".\"id\" left join \"config\" on \"invoice\".\"config_id\" = \"config\".\"id\" group by \"line_item\".\"id\", \"config\".\"id\""
			}
