			"op": "alter",
			"key": "views\u0000[\"public\",\"document_with_sum\"]",
			"set": {
				"definition": "select \"document\".\"id\", \"document\".\"user_id\", \"document\".\"client_data_id\", \"document\".\"title\", \"document\".\"description\", \"document\".\"created_at\", \"document\".\"config_id\", \"config\".\"tax_registration\", \"config\".\"currency\", coalesce(sum(\"items_with_tax\".\"net_amount\"),0) as \"net_total\", coalesce(sum(\"items_with_tax\".\"gross_amount\"),0) as \"gross_total\" from \"document\" inner join \"config\" on \"document\".\"config_id\" = \"config\".\"id\" left join \"items_with_tax\" on \"items_with_tax\".\"document_id\" = \"document\".\"id\" group by \"document\".\"id\", \"config\".\"id\""
			}
		},
		{
			"op": "alter",
			"key": "views\u0000[\"public\",\"items_with_tax\"]",
			"set": {
				"definition": "select \"line_item\".\"id\", \"line_item\".\"document_id\", \"line_item\".\"label\", \"line_item\".\"note\", \"line_item\".\"quantity\", \"line_item\".\"unit\", \"line_item\".\"unit_cost\", \"line_item\".\"net_amount\", \"line_item\".\"order\", \"line_item\".\"user_id\", \"line_item\".\"config_id\", \"config\".\"tax_registration\", ((1 + COALESCE(sum(\"tax\".\"rate\") * \"config\".\"tax_registration\"::INT, 0)) * \"line_item\".\"net_amount\")::NUMERIC(19, 4) as \"gross_amount\" from \"line_item\" left join \"item_tax\" on \"item_tax\".\"item_id\" = \"line_item\".\"id\" left join \"tax\" on \"item_tax\".\"tax_id\" = \"tax\".\"id\" left join \"document\" on \"line_item\".\"document_id\" = \"document\".\"id\" left join \"config\" on \"document\".\"config_id\" = \"config\".\"id\" group by \"line_item\".\"id\", \"config\".\"id\""
